{
  "schema_version": 2,
  "comment": "Arena 会话执行通道：本项目主链路是中文单集剧本。每阶段落产物；机械检查与编辑审读分离；缺正文或缺审读证据不得声称完成。",
  "project": {
    "kind": "screenplay",
    "entry_skill": "skills/arena-screenplay/SKILL.md",
    "craft_refs": [
      "skills/arena-screenplay/references/剧本契约.md",
      "skills/arena-screenplay/references/抖音原生剧本.md",
      "skills/arena-screenplay/references/拆文语料使用.md",
      "skills/arena-screenplay/references/审读契约.md"
    ],
    "review_skill": "skills/arena-screenplay/SKILL.md",
    "source_library": "拆文库/",
    "legacy_project": {
      "kind": "fuben-copywriting",
      "entry_skill": "skills/fuben-write/SKILL.md",
      "scope": "仅维护历史作品/与旧工具回归；新任务不自动进入该管线"
    }
  },
  "executors": {
    "active": "arena-inprocess",
    "available": [
      "arena-inprocess"
    ]
  },
  "pipeline": {
    "name": "arena-screenplay",
    "products_dir": "剧集/EP<NNN>/",
    "stages": [
      {
        "id": "00",
        "name": "项目简报",
        "role": "主控",
        "product": "项目简报.md",
        "requires": [
          "观看承诺",
          "主角目标",
          "阻力策略",
          "本集兑现与退出状态",
          "时长/拍摄/事实边界（如有）"
        ]
      },
      {
        "id": "01",
        "name": "素材与必要检索",
        "role": "研究/策划",
        "product": "素材记录.md（需要时）",
        "requires": {
          "read_owned_source_first": true,
          "search": "按需；只查会影响行动可信度的现实细节",
          "no_search_quota": true,
          "no_copy_source_lines": true
        }
      },
      {
        "id": "02",
        "name": "单集因果锁定",
        "role": "策划",
        "product": "上下文契约（默认不另落节拍表）",
        "requires": {
          "each_scene": [
            "goal",
            "opposition",
            "action",
            "result/state_change"
          ],
          "parallel_listing_is_not_drama": true
        }
      },
      {
        "id": "03",
        "name": "剧本正文",
        "role": "主笔",
        "product": "剧集/EP<NNN>/剧本.md",
        "requires": {
          "single_canonical_body": true,
          "scene_heading": "## EP001-SC001 内·地点·时间",
          "action_and_dialogue": true,
          "every_scene_changes_state": true,
          "cta_not_in_story": true
        }
      },
      {
        "id": "04",
        "name": "编辑审读与定点返工",
        "role": "审读→主笔",
        "product": "审核/EP<NNN>.md",
        "requires": {
          "quote_and_line_evidence": true,
          "reviewer_not_author_self_approval": true,
          "status_before_independent_review": "PROVISIONAL",
          "questions": [
            "最早失去追看的场景",
            "目标/阻力/行动/结果",
            "最弱对白或说明段",
            "视觉/声音可拍性",
            "结尾兑现与代价"
          ]
        }
      },
      {
        "id": "05",
        "name": "机械校验与绑定",
        "role": "scripts/arena_screenplay_check.py",
        "product": "审核/EP<NNN>.md 内的机械摘要",
        "checks": [
          "UTF-8/正文存在",
          "场景标题与编号",
          "空场与对白格式",
          "明显审核元话语",
          "正文 SHA-256 绑定"
        ],
        "note": "mechanical_status=PASS 不是 editorial_status=APPROVED，也不是发布许可"
      }
    ]
  },
  "rules": {
    "deliverables": [
      "剧集/EP<NNN>/剧本.md",
      "审核/EP<NNN>.md"
    ],
    "honesty": [
      "不报必爆",
      "不把搜索路数、关键词数量、物证数量或机器 PASS 当创作质量",
      "不把主会话自检冒充独立多人会审",
      "正文改变后旧审核必须标记 STALE"
    ]
  },
  "legacy_pipeline": {
    "pipeline": {
      "name": "fuben-write",
      "products_dir": "作品/NN_主题/_运行/",
      "stages": [
        {
          "id": "00",
          "name": "简报",
          "role": "主控",
          "product": "00_简报.md"
        },
        {
          "id": "01",
          "name": "深读+检索+选题",
          "role": "策划",
          "product": "01_深读_检索与方向.md"
        },
        {
          "id": "02",
          "name": "人生时间轴",
          "role": "策划",
          "product": "02_场次单.md"
        },
        {
          "id": "03",
          "name": "成稿",
          "role": "主笔",
          "product": "03_初稿.md"
        },
        {
          "id": "04",
          "name": "审读与返工",
          "role": "审读+主笔",
          "product": "04_审读与返工.md"
        },
        {
          "id": "05",
          "name": "机检",
          "role": "旧 fuben 工具",
          "product": "05_机检.json"
        }
      ]
    },
    "rules": {
      "deliverables": [
        "正文.md",
        "钩子备选.md"
      ],
      "optional_deliverables": [
        "正文_3分钟版.md",
        "分镜建议.md"
      ]
    }
  }
}
